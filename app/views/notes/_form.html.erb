<%= form_with(model: note) do |form| %>
  <% if note.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(note.errors.count, "error") %> prohibited this note from being saved:</h2>

      <ul>
        <% note.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :book_id %>
    <%= form.collection_select :book_id, @books, :id, :name%>
  </div>

  <div class="field">
    <%=form.label :content %>
    <%=form.rich_text_area :content %>
  </div>

  <%# El botón de volver se rinde acá adentro para que quede en la misma fila
      que el de envío. Antes vivía en new/edit, después del form, y caía en un
      renglón aparte con otro tamaño. %>
  <div class="actions">
    <%= form.submit %>
    <%= link_to cancel_label, cancel_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
