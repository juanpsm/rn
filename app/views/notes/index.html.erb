<% actions = capture do %>
  <%= add_button new_note_path, "add", title: "Add a new note" %>
  <%= action_button :download, notes_download_all_path,
      label: "Download all your notes in one PDF" %>
  <%= action_button :archive, notes_download_separately_path,
      label: "Download a ZIP with one PDF per note" %>
<% end %>

<%= render "shared/page_header", title: "Notes", crumbs: [["notes"]], actions: actions %>

<div class="container-fluid">
  <div class="row">
    <% if @notes.blank? %>
      <p class="text-secondary">There is nothing here yet.</p>
    <% else %>
      <%= render @notes %>
    <% end %>
  </div>
</div>
