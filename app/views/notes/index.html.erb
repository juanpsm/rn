<div class="app-content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1 class="m-0 text-body-emphasis">Notes</h1>
      </div><!-- /.col -->
      <div class="col-sm-6">
        <div class="float-sm-end">
          <%= link_to(new_note_path, class:"btn bg-accent") do %>
            <i class="fas fa-plus"></i> add
          <%end%>
          <%= link_to(notes_download_all_path, class:"btn bg-primary", 
              title:"Download ALL your notes in ONE file.") do %>
            <i class="fas fa-download"></i>
          <%end%>
          <%# Ya no baja un archivo por nota, sino un ZIP con un PDF por nota:
              una request HTTP devuelve una sola respuesta. Se ajustan el texto
              y el ícono, y se quita el confirm que avisaba de "lots of files". %>
          <%= link_to(notes_download_separately_path, class:"btn btn-secondary",
              title:"Download a ZIP with one PDF per note.") do %>
            <i class="fas fa-file-archive"></i>
          <%end%>
        </div><!-- /.float -->
      </div><!-- /.col -->
    </div><!-- /.row -->
  </div><!-- /.container-fluid -->
</div>

<div class="container-fluid">
  <div class="container-fluid">
    <div class="row">
      <% unless @notes.blank? %>
        <%= render @notes %>
      <%else%>
        There is nothing here yet.
      <%end%>
    </div>
  </div>
</div>
