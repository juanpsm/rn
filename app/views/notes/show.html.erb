<% if request.format.html? %>
  <% actions = capture do %>
    <%= action_button :pdf, note_path(@note, format: "pdf") %>
    <%= action_button :download, note_download_path(@note) %>
    <%= action_button :edit, edit_note_path(@note), label: "Edit note" %>
    <%= action_button :destroy, note_path(@note), label: "Delete note", method: :delete,
        confirm: "Are you sure? This cannot be undone." %>
  <% end %>

  <%# Ya no hay botón "Back": las migas cumplen la misma función y estaban
      duplicando la navegación con dos vocabularios distintos. %>
  <%= render "shared/page_header",
      title: @note.title,
      crumbs: [["notes", notes_path], [@note.book.name, book_path(@note.book)], [@note.title]],
      actions: actions %>
<% else %>
  <%# En el PDF no hay navegación ni acciones: sólo el título y el libro. %>
  <div class="app-content-header">
    <div class="container-fluid">
      <h1 class="m-0"><%= @note.title %></h1>
      <p class="text-muted">from: <em><%= @note.book.name %></em></p>
    </div>
  </div>
<% end %>

<div class="container-fluid">
  <div class="card">
    <div class="card-body">
      <%= @note.content %>
    </div>
    <%# Antes se imprimía el timestamp crudo con zona ("2026-07-28 03:45:55
        UTC"), que además no coincidía con el "hace un rato" del listado. %>
    <div class="card-footer small text-muted text-end p-1">
      creada el <%= l @note.created_at, format: :long %>
      <% if @note.updated_at && @note.updated_at != @note.created_at %>
        &middot; editada <%= time_ago_in_words @note.updated_at %> atrás
      <% end %>
    </div>
  </div>
</div>
