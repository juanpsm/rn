<!-- Navbar -->
<nav class="app-header navbar navbar-expand bg-body">
  <div class="container-fluid">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
      <li class="nav-item">
        <%# En AdminLTE 4 el botón de plegar el sidebar usa data-lte-toggle. %>
        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle sidebar">
          <i class="fas fa-bars"></i>
        </a>
      </li>
      <li class="nav-item d-none d-sm-inline-block">
        <%= link_to 'Home', root_path, class:"nav-link" %>
      </li>
    </ul>

    <%if user_signed_in?%>
      <!-- SEARCH FORM -->
      <%# Bootstrap 5 eliminó .form-inline; se reemplaza por d-flex. %>
      <%= form_tag "/notes", method: "GET", class: "d-flex ms-3" do %>
        <%# En BS5 el input-group ya no lleva .input-group-append: los hijos se
            ordenan solos. %>
        <div class="input-group input-group-sm">
          <%= text_field_tag :search, params[:search], class: "form-control",
             type: "search", placeholder: "Search notes", 'aria-label' => 'Search' %>
          <%= button_tag(type: "submit", class: "btn btn-outline-secondary") do %>
            <i class="fas fa-search"></i>
          <% end %>
        </div>
      <% end %>

      <!-- Right navbar links -->
      <ul class="navbar-nav ms-auto">
        <!-- Dropdown Menu -->
        <li class="nav-item dropdown">
          <a class="nav-link" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
            <i class="fas fa-2x fa-cog"></i>
          </a>
          <div class="dropdown-menu dropdown-menu-end">
            <%# Antes acá había un "Options:" que no hacía nada, y la página de
                editar la cuenta no tenía ningún link que llegara a ella. %>
            <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
              <i class="fas fa-user"></i> My account
            <% end %>
            <div class="dropdown-divider"></div>
            <%= link_to(destroy_user_session_path, method: :delete, data: { confirm: 'Are you sure? Ok, bye then!' },
                class:"dropdown-item") do %>
              <i class="fas fa-sign-out-alt"></i> Logout
            <%end%>
          </div>
        </li>
      </ul>
    <%end%>
  </div>
</nav>
