<!-- Main Sidebar Container -->
<%# AdminLTE 4: .main-sidebar pasó a .app-sidebar, y el tema oscuro ya no se
    pide con .sidebar-dark-primary sino con data-bs-theme de Bootstrap 5. %>
<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
  <!-- Brand Logo -->
  <div class="sidebar-brand">
    <a href="#" class="brand-link text-center">
      <%# Sin `rounded-circle` ni `opacity`: el logo es pixel art y el recorte
          circular le comía las esquinas. `pixelated` evita que el navegador lo
          suavice al reducirlo. %>
      <%= image_tag "logo.png", class: "brand-image brand-image-pixel", alt: "RubyNotes" %>
      <span class="brand-text fw-light">RubyNotes</span>
    </a>
  </div>

  <!-- Sidebar -->
  <div class="sidebar-wrapper">
    <%if user_signed_in?%>
      <!-- Sidebar user panel (optional) -->
      <%# .user-panel / .image / .info no existen en v4: se arma con utilidades
          de Bootstrap. %>
      <%# El avatar sale del helper, que resuelve foto subida / Gravatar /
          inicial. Es un link a "Mi cuenta", que es donde se cambia. %>
      <div class="d-flex align-items-center gap-2 mt-3 pb-3 mb-3 px-3">
        <%= link_to edit_user_registration_path, class: "d-flex align-items-center gap-2 text-decoration-none overflow-hidden" do %>
          <%= user_avatar_tag current_user %>
          <%# `text-body-emphasis` es necesario: el <span> heredaría el color
              del body (tema claro) y quedaría casi negro sobre el sidebar
              oscuro. El `data-bs-theme` del aside redefine variables, pero no
              aplica `color` por sí solo. %>
          <span class="text-truncate text-body-emphasis" title="<%= current_user.email %>"><%= current_user.email %></span>
        <% end %>
      </div>
    <%end%> <!-- /.if user_signed_in? -->

    <!-- Sidebar Menu -->
    <nav class="mt-2">
      <%# .nav-sidebar pasó a .sidebar-menu y data-widget="treeview" a
          data-lte-toggle="treeview". %>
      <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
        <!-- Add icons to the links using the .nav-icon class
              with font-awesome or any other icon font library -->
        <%if user_signed_in?%>
          <li class="nav-item">
            <%= link_to(new_note_path, class:"nav-link bg-accent") do %>
              <i class="nav-icon fas fa-plus"></i>
              <p>
                New Note
              </p>
            <%end%>
          </li>
          <li class="nav-item">
            <%= link_to(notes_path, class:"nav-link") do %>
              <i class="nav-icon fas fa-file-alt"></i>
              <p>
                All Notes
                <span class="nav-badge badge bg-danger me-3"><%= current_user.notes.count %></span>
              </p>
            <%end%>
          </li>
          <li class="nav-item">
            <!--sacar link no hace nada-->
            <%= link_to(books_path, class:"nav-link") do %>
              <i class="nav-icon fas fa-book"></i>
              <p>
                Books
                <i class="nav-arrow fas fa-angle-left"></i>
              </p>
            <%end%>
            <ul class="nav nav-treeview">
              <li class="nav-item">
                <%= link_to(new_book_path, class:"nav-link bg-accent") do %>
                  <i class="nav-icon fas fa-book-medical"></i>
                  <p>
                    New Book
                  </p>
                <%end%>
              </li>
              <li class="nav-item">
                <%= link_to(books_path, class:"nav-link") do %>
                  <i class="nav-icon fas fa-book"></i>
                  <p>
                    All Books
                    <span class="nav-badge badge bg-danger me-3"><%= current_user.books.count %></span>
                  </p>
                <%end%>
              </li>
              <% current_user.books.each do |book| %>
                <li class="nav-item">
                  <%= link_to(book, class:"nav-link") do %>
                    <i class="fas fa-book-open nav-icon"></i>
                    <p><%= book.name %></p>
                  <%end%>
                </li>
              <%end%>
            </ul>
          </li>
        <%else%> <!-- /.if user_signed_in? -->
          <%# Estos son botones, no ítems de menú: `nav-icon` les fija un ancho
              y un alineado pensados para el sidebar y descolocaba el ícono
              respecto del texto. Se centra con flex. %>
          <li class="nav-item px-3">
            <%# BS5 eliminó .btn-block: se usa w-100. %>
            <%= link_to(new_user_session_path, class:"btn btn-primary btn-inline-icon w-100") do %>
              <i class="fas fa-sign-in-alt"></i> Login
            <%end%>
          </li>
          <li class="nav-item mt-2 px-3">
            <%= link_to(new_user_registration_path, class:"btn btn-inline-icon w-100 bg-accent") do %>
              <i class="fas fa-user-plus"></i> Sign Up
            <%end%>
          </li>
        <%end%> <!-- /.if user_signed_in? -->
      </ul>
    </nav>
    <!-- /.sidebar-menu -->
  </div>
  <!-- /.sidebar-wrapper -->
</aside>
