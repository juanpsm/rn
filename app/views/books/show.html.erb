<% actions = capture do %>
  <%# El orden de las acciones es el mismo que en notes/show: primero las de
      salida (descargas), después editar y por último borrar. Acá venían al
      revés. %>
  <%= action_button :download, download_all_notes_from_book_path(@book),
      label: "Download all notes from this book in one PDF" %>
  <%= action_button :edit, edit_book_path(@book), label: "Edit book" %>
  <%# Bug: apuntaba a `note_path` sin argumento. Los helpers de ruta rellenan
      el `:id` que falta con el de la request en curso, así que en vez de
      fallar generaban `/notes/<id-del-libro>`: el botón "Delete book"
      mandaba a borrar una nota cualquiera que tuviera ese id. %>
  <%= action_button :destroy, book_path(@book), label: "Delete book", method: :delete,
      confirm: "Are you sure? This will delete all notes within this book and cannot be undone." %>
<% end %>

<%= render "shared/page_header",
    title: @book.name,
    crumbs: [["books", books_path], [@book.name]],
    actions: actions %>

<div class="container-fluid">
  <p class="text-secondary"><%= pluralize(@book.notes.size, "note") %></p>
  <div class="row">
    <% if @book.notes.blank? %>
      <p class="text-secondary">There is nothing here yet.</p>
    <% else %>
      <%= render @book.notes %>
    <% end %>
  </div>
</div>
